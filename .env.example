# Competition runtime configuration
# Copy to .env and fill in private values.

# AIVIX / Cryptoracle indicator API
CRYPTORACLE_API_BASE_URL=https://service.cryptoracle.network
CRYPTORACLE_API_KEY=replace-with-your-access-key

# Index One index calculation API
INDEXONE_API_BASE_URL=https://api.indexone.io
INDEXONE_API_KEY=replace-with-your-team-api-key

# Ricequant RQData (license credential; not a Japanese-equity data source)
RQDATA_USERNAME=license
RQDATA_PASSWORD=replace-with-your-rqdata-license

# IBKR Gateway paper API
IBKR_HOST=127.0.0.1
IBKR_PORT_PAPER=4002
IBKR_CLIENT_ID=91
# IBKR_ACCOUNT_ID=optional-account-id

# Competition execution runner (Paper-first)
COMPETITION_EXECUTION_ENVIRONMENT=paper
COMPETITION_EXECUTION_GATEWAY_HOST=127.0.0.1
COMPETITION_EXECUTION_GATEWAY_PORT=4002
COMPETITION_EXECUTION_CLIENT_ID=7310
COMPETITION_EXECUTION_DRY_RUN=true
# Windows-side light computation guardrails; keep headroom for IBKR Gateway.
COMPETITION_COMPUTE_MAX_WORKERS=2
COMPETITION_COMPUTE_MAX_MEMORY_GB=8
# Live mode requires explicit environment-only guards; do not put them here.

# QuantZone candidate A-share factor source (optional; adapter not implemented)
QUANTZONE_API_BASE_URL=https://api.quantzone.tech
QUANTZONE_ACCESS_KEY=
# SDK argument: sign_secret (console label: Secret Key)
QUANTZONE_SECRET_KEY=
