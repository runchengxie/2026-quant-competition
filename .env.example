# Local execution settings. Copy to .env.local; never commit credentials.
# The Windows runner defaults to Paper Gateway at 127.0.0.1:4002.
COMPETITION_EXECUTION_ENVIRONMENT=paper
COMPETITION_EXECUTION_GATEWAY_HOST=127.0.0.1
COMPETITION_EXECUTION_GATEWAY_PORT=4002
COMPETITION_EXECUTION_CLIENT_ID=7310
COMPETITION_EXECUTION_DRY_RUN=true

# Live mode is intentionally disabled. Do not add real account credentials here.
# A supervised live run requires both values in the process environment:
# COMPETITION_EXECUTION_LIVE_ENABLED=true
# COMPETITION_EXECUTION_LIVE_CONFIRMATION=ENABLE_LIVE_TRADING
