{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "market",
    "status",
    "issue_codes",
    "prepared_at",
    "collected_at",
    "manifest",
    "manifest_sha256",
    "parent_protocol_id",
    "new_protocol_id",
    "warmup",
    "warmup_end",
    "next_eligible_date",
    "candidates",
    "costs",
    "observations",
    "availability_review_required",
    "execution_authorized"
  ],
  "properties": {
    "market": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "issue_codes": {
      "type": "array"
    },
    "prepared_at": {
      "type": "string"
    },
    "collected_at": {
      "type": "string"
    },
    "manifest": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string"
    },
    "parent_protocol_id": {
      "type": "string"
    },
    "new_protocol_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "warmup": {
      "type": [
        "object",
        "null"
      ]
    },
    "warmup_end": {
      "type": "string"
    },
    "next_eligible_date": {
      "type": "string"
    },
    "candidates": {
      "type": "array"
    },
    "costs": {
      "type": "array"
    },
    "observations": {
      "const": 0
    },
    "availability_review_required": {
      "const": true
    },
    "execution_authorized": {
      "const": false
    },
    "schema": {
      "const": "competition.observation_preparation.v1"
    }
  }
}
