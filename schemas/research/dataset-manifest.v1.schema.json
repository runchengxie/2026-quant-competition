{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "competition.dataset_manifest.v1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "spec": {
      "type": "object"
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "available_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "acquired",
        "partial",
        "blocked"
      ]
    },
    "coverage": {
      "type": "object"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "accepted_research": {
      "const": false
    }
  },
  "required": [
    "schema",
    "dataset_id",
    "version",
    "spec_hash",
    "spec",
    "observed_at",
    "available_at",
    "status",
    "coverage",
    "gaps",
    "files",
    "accepted_research"
  ]
}
