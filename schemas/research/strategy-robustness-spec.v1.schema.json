{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_research",
    "expected_parent_plan_sha256",
    "expected_parent_results_sha256",
    "parent_plan",
    "parent_results",
    "role",
    "schema"
  ],
  "properties": {
    "accepted_research": {
      "const": false
    },
    "expected_parent_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_parent_results_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_plan": {
      "type": "string"
    },
    "parent_results": {
      "type": "string"
    },
    "role": {
      "const": "retrospective_diagnostic"
    },
    "schema": {
      "const": "competition.strategy_robustness_spec.v1"
    }
  }
}
