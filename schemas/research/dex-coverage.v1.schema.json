{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "start",
    "end",
    "expected_intervals",
    "observed_intervals",
    "missing_intervals",
    "gaps"
  ],
  "properties": {
    "schema": {
      "const": "competition.dex_coverage.v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial"
      ]
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
    },
    "expected_intervals": {
      "type": "integer",
      "minimum": 0
    },
    "observed_intervals": {
      "type": "integer",
      "minimum": 0
    },
    "missing_intervals": {
      "type": "integer",
      "minimum": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "hours"
        ],
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
          },
          "hours": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
