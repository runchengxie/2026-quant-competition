{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "version",
    "spec",
    "spec_sha256",
    "protocol_sha256",
    "status",
    "units",
    "files",
    "coverage",
    "snapshots",
    "budget",
    "availability",
    "created_at",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "competition.dex_dataset_manifest.v1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "spec": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "interval",
        "quote_currency",
        "selection",
        "dataset_id",
        "version",
        "start",
        "end",
        "credential_file",
        "protocol_file",
        "protocol_sha256",
        "assets",
        "budget"
      ],
      "properties": {
        "schema": {
          "const": "competition.dex_dataset_spec.v1"
        },
        "source": {
          "const": "dexpaprika"
        },
        "interval": {
          "const": "1h"
        },
        "quote_currency": {
          "const": "USD"
        },
        "selection": {
          "const": "fixed_current"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$",
          "format": "date-time"
        },
        "credential_file": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
        },
        "protocol_file": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stable_id",
              "underlying_id",
              "network",
              "address"
            ],
            "properties": {
              "stable_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "underlying_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "network": {
                "enum": [
                  "ethereum",
                  "solana"
                ]
              },
              "address": {
                "type": "string",
                "minLength": 1
              },
              "pool_address": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "network": {
                      "const": "ethereum"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "address": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{40}$"
                    },
                    "pool_address": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{40}$"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "address": {
                      "type": "string",
                      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                    },
                    "pool_address": {
                      "type": "string",
                      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                    }
                  }
                }
              }
            ]
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "bytes",
            "seconds",
            "requests_per_minute"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52428800
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            },
            "requests_per_minute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      }
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked"
      ]
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "volume"
      ],
      "properties": {
        "price": {
          "const": "USD"
        },
        "volume": {
          "const": "USD"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "raw",
              "normalized",
              "snapshot",
              "protocol",
              "receipt"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "schema",
          "status",
          "start",
          "end",
          "expected_intervals",
          "observed_intervals",
          "missing_intervals",
          "gaps"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "schema": {
            "const": "competition.dex_coverage.v1"
          },
          "status": {
            "enum": [
              "completed",
              "partial"
            ]
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
          },
          "expected_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "observed_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "missing_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "hours"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
                },
                "hours": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "network",
          "pool_address",
          "observed_at",
          "source",
          "historical_coverage"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "network": {
            "enum": [
              "ethereum",
              "solana"
            ]
          },
          "pool_address": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "const": "dexpaprika"
          },
          "historical_coverage": {
            "const": false
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "bytes",
        "seconds"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52428801
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "availability": {
      "const": "bar_close_proxy_unverified"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
