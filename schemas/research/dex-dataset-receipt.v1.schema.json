{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_sha256",
    "protocol_sha256",
    "status",
    "coverage",
    "snapshots",
    "spent",
    "units",
    "units_source",
    "issues",
    "checkpoints",
    "completed_resources"
  ],
  "properties": {
    "schema": {
      "const": "competition.dex_dataset_receipt.v1"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "schema",
          "status",
          "start",
          "end",
          "expected_intervals",
          "observed_intervals",
          "missing_intervals",
          "gaps"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "schema": {
            "const": "competition.dex_coverage.v1"
          },
          "status": {
            "enum": [
              "completed",
              "partial"
            ]
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
          },
          "expected_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "observed_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "missing_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "hours"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
                },
                "hours": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "network",
          "pool_address",
          "observed_at",
          "source",
          "historical_coverage"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "network": {
            "enum": [
              "ethereum",
              "solana"
            ]
          },
          "pool_address": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "const": "dexpaprika"
          },
          "historical_coverage": {
            "const": false
          }
        }
      }
    },
    "spent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "bytes",
        "seconds"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52428801
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "volume"
      ],
      "properties": {
        "price": {
          "const": "USD"
        },
        "volume": {
          "const": "USD"
        }
      }
    },
    "units_source": {
      "const": "https://docs.dexpaprika.com/tutorials/token-ohlcv"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "raw",
              "normalized",
              "snapshot",
              "protocol",
              "receipt"
            ]
          }
        }
      }
    },
    "completed_resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
