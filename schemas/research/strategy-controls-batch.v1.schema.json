{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competition.strategy_controls_batch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "market",
    "jobs"
  ],
  "properties": {
    "schema": {
      "const": "competition.strategy_controls_batch.v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "market": {
      "enum": [
        "US",
        "crypto"
      ]
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_sha256",
          "manifest",
          "benchmark",
          "code_commit",
          "manifest_sha256",
          "dates",
          "arm_id",
          "input_slice",
          "input_files",
          "project",
          "parameters",
          "evidence_role",
          "accounting_model",
          "accepted_research",
          "fee_bps",
          "quote_currency",
          "catalog_sha256",
          "fold",
          "products",
          "schema",
          "expected_leaf_sha256",
          "execution_assumption",
          "market",
          "job_id"
        ],
        "properties": {
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest": {
            "type": "string"
          },
          "benchmark": {
            "type": [
              "string",
              "null"
            ]
          },
          "code_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dates": {
            "type": "array"
          },
          "arm_id": {
            "type": "string"
          },
          "input_slice": {
            "type": "object"
          },
          "input_files": {
            "type": "array"
          },
          "project": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "evidence_role": {
            "type": "string"
          },
          "accounting_model": {
            "const": "self_financing_daily.v1"
          },
          "accepted_research": {
            "const": false
          },
          "fee_bps": {
            "type": "integer",
            "enum": [
              0,
              10,
              20,
              25,
              40
            ]
          },
          "quote_currency": {
            "type": "string"
          },
          "catalog_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fold": {
            "type": "object"
          },
          "products": {
            "type": "array"
          },
          "schema": {
            "const": "competition.strategy_controls_job.v1"
          },
          "expected_leaf_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "execution_assumption": {
            "const": "lagged_close_proxy"
          },
          "market": {
            "enum": [
              "US",
              "crypto"
            ]
          },
          "job_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
