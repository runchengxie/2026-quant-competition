{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competition research input adapter receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market",
    "source_state",
    "price_basis",
    "universe_state",
    "availability_state",
    "schema_version",
    "producer",
    "dataset_id",
    "synthetic",
    "timezone",
    "files",
    "quality",
    "fingerprint"
  ],
  "properties": {
    "market": {
      "type": "string",
      "enum": [
        "CRYPTO",
        "HK",
        "US"
      ]
    },
    "source_state": {
      "type": "string",
      "enum": [
        "archived_unverified",
        "owner_published",
        "synthetic"
      ]
    },
    "price_basis": {
      "type": "string",
      "enum": [
        "adjusted",
        "raw",
        "unknown"
      ]
    },
    "universe_state": {
      "type": "string",
      "enum": [
        "fixed_current",
        "point_in_time",
        "synthetic",
        "unknown"
      ]
    },
    "availability_state": {
      "type": "string",
      "enum": [
        "period_only",
        "unknown",
        "verified"
      ]
    },
    "schema_version": {
      "const": "competition.research_input_receipt.v1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "package_version",
        "code_revision"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "code_revision": {
          "type": "string",
          "pattern": "^(unknown|[0-9a-f]{40})$"
        }
      }
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "kind",
          "sha256",
          "size_bytes",
          "rows"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "daily_bars",
              "fundings",
              "orderbook",
              "trades"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_codes"
      ],
      "properties": {
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
