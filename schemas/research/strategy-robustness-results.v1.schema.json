{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "status",
    "elapsed_seconds",
    "jobs",
    "capacity"
  ],
  "properties": {
    "schema": {
      "const": "competition.strategy_robustness_results.v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "jobs": {
      "type": "array",
      "minItems": 114,
      "maxItems": 114
    },
    "capacity": {
      "type": "array",
      "minItems": 0,
      "maxItems": 288
    }
  }
}
