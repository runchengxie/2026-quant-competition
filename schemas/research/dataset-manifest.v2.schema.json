{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "version",
    "spec_hash",
    "spec",
    "receipt",
    "observed_at",
    "status",
    "coverage",
    "gaps",
    "files",
    "parent_manifest_sha256",
    "accepted_research"
  ],
  "properties": {
    "schema": {
      "const": "competition.dataset_manifest.v2"
    },
    "dataset_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "spec": {
      "title": "Bounded daily equity specification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dataset_id",
        "version",
        "source",
        "market",
        "products",
        "benchmark",
        "quote_currency",
        "start",
        "end",
        "timezone",
        "calendar",
        "price_basis",
        "universe_status",
        "budget",
        "contracts"
      ],
      "properties": {
        "schema": {
          "const": "competition.dataset_spec.v2"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "source": {
          "const": "ibkr_daily"
        },
        "market": {
          "enum": [
            "US",
            "HK"
          ]
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          }
        },
        "benchmark": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "quote_currency": {
          "enum": [
            "USD",
            "HKD"
          ]
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "enum": [
            "America/New_York",
            "Asia/Hong_Kong"
          ]
        },
        "calendar": {
          "enum": [
            "XNYS",
            "XHKG"
          ]
        },
        "price_basis": {
          "const": "split_adjusted"
        },
        "universe_status": {
          "const": "fixed_current"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "bytes",
            "seconds"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2400
            }
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 21,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product",
              "symbol",
              "exchange",
              "currency",
              "role"
            ],
            "properties": {
              "product": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,19}$"
              },
              "symbol": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,19}$"
              },
              "exchange": {
                "enum": [
                  "SMART",
                  "SEHK"
                ]
              },
              "currency": {
                "enum": [
                  "USD",
                  "HKD"
                ]
              },
              "role": {
                "enum": [
                  "stock",
                  "benchmark"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "market": {
                "const": "US"
              }
            }
          },
          "then": {
            "properties": {
              "quote_currency": {
                "const": "USD"
              },
              "calendar": {
                "const": "XNYS"
              },
              "timezone": {
                "const": "America/New_York"
              },
              "contracts": {
                "items": {
                  "properties": {
                    "exchange": {
                      "const": "SMART"
                    },
                    "currency": {
                      "const": "USD"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "market": {
                "const": "HK"
              }
            }
          },
          "then": {
            "properties": {
              "quote_currency": {
                "const": "HKD"
              },
              "calendar": {
                "const": "XHKG"
              },
              "timezone": {
                "const": "Asia/Hong_Kong"
              },
              "contracts": {
                "items": {
                  "properties": {
                    "exchange": {
                      "const": "SEHK"
                    },
                    "currency": {
                      "const": "HKD"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "spec_hash",
        "observed_at",
        "status",
        "coverage",
        "gaps",
        "issue_codes",
        "resolved_contracts",
        "calendar",
        "adjustment_evidence",
        "requests",
        "elapsed_seconds",
        "retained_payload_bytes",
        "parent_manifest_sha256",
        "revisions",
        "accepted_research"
      ],
      "properties": {
        "schema": {
          "const": "competition.dataset_receipt.v2"
        },
        "spec_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "acquired",
            "partial"
          ]
        },
        "coverage": {
          "type": "object"
        },
        "gaps": {
          "type": "array"
        },
        "issue_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "resolved_contracts": {
          "type": "object"
        },
        "calendar": {
          "type": "object"
        },
        "adjustment_evidence": {
          "type": "object"
        },
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "retained_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "parent_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "revisions": {
          "type": "array"
        },
        "accepted_research": {
          "const": false
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "acquired",
        "partial"
      ]
    },
    "coverage": {
      "type": "object"
    },
    "gaps": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(raw|normalized)/[^/\\\\:]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "parent_manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "accepted_research": {
      "const": false
    }
  }
}
