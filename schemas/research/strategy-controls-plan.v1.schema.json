{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competition.strategy_controls_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "frozen_at",
    "spec",
    "code_commit",
    "source_sha256",
    "source_snapshot",
    "catalog_sha256",
    "inputs",
    "jobs",
    "plan_sha256",
    "scientific_source_files"
  ],
  "properties": {
    "schema": {
      "const": "competition.strategy_controls_plan.v1"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "manifests",
        "expected_input_hashes",
        "arms",
        "costs",
        "role",
        "accepted_research",
        "budget"
      ],
      "properties": {
        "schema": {
          "const": "competition.strategy_controls_spec.v1"
        },
        "manifests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US",
            "crypto"
          ],
          "properties": {
            "US": {
              "type": "string"
            },
            "crypto": {
              "type": "string"
            }
          }
        },
        "expected_input_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US",
            "crypto"
          ],
          "properties": {
            "US": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "crypto": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US",
            "crypto"
          ],
          "properties": {
            "US": {
              "const": [
                "ew_daily",
                "ew_monthly",
                "ew_monthly_buffer20",
                "mom20_daily",
                "mom20_monthly",
                "mom20_monthly_buffer20"
              ]
            },
            "crypto": {
              "const": [
                "ew_legacy",
                "trend200_legacy",
                "trend200_vol40_legacy",
                "trend200_fixed60_legacy",
                "trend200_vol40_strict",
                "ew_fixed60",
                "ew_vol40_strict",
                "ew_trend_gross_matched"
              ]
            }
          }
        },
        "costs": {
          "const": {
            "US": [
              20,
              40
            ],
            "crypto": [
              0,
              10,
              25
            ]
          }
        },
        "role": {
          "const": "retrospective"
        },
        "accepted_research": {
          "const": false
        },
        "budget": {
          "const": {
            "jobs": 512,
            "seconds": 3600,
            "batch_jobs": 384
          }
        }
      }
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_snapshot": {
      "type": "object"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "object"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_sha256",
          "manifest",
          "benchmark",
          "code_commit",
          "manifest_sha256",
          "dates",
          "arm_id",
          "input_slice",
          "input_files",
          "project",
          "parameters",
          "evidence_role",
          "accounting_model",
          "accepted_research",
          "fee_bps",
          "quote_currency",
          "catalog_sha256",
          "fold",
          "products",
          "schema",
          "expected_leaf_sha256",
          "execution_assumption",
          "market",
          "job_id"
        ],
        "properties": {
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest": {
            "type": "string"
          },
          "benchmark": {
            "type": [
              "string",
              "null"
            ]
          },
          "code_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dates": {
            "type": "array"
          },
          "arm_id": {
            "type": "string"
          },
          "input_slice": {
            "type": "object"
          },
          "input_files": {
            "type": "array"
          },
          "project": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "evidence_role": {
            "type": "string"
          },
          "accounting_model": {
            "const": "self_financing_daily.v1"
          },
          "accepted_research": {
            "const": false
          },
          "fee_bps": {
            "type": "integer",
            "enum": [
              0,
              10,
              20,
              25,
              40
            ]
          },
          "quote_currency": {
            "type": "string"
          },
          "catalog_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fold": {
            "type": "object"
          },
          "products": {
            "type": "array"
          },
          "schema": {
            "const": "competition.strategy_controls_job.v1"
          },
          "expected_leaf_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "execution_assumption": {
            "const": "lagged_close_proxy"
          },
          "market": {
            "enum": [
              "US",
              "crypto"
            ]
          },
          "job_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scientific_source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
