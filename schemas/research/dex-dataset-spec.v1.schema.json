{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "interval",
    "quote_currency",
    "selection",
    "dataset_id",
    "version",
    "start",
    "end",
    "credential_file",
    "protocol_file",
    "protocol_sha256",
    "assets",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "competition.dex_dataset_spec.v1"
    },
    "source": {
      "const": "dexpaprika"
    },
    "interval": {
      "const": "1h"
    },
    "quote_currency": {
      "const": "USD"
    },
    "selection": {
      "const": "fixed_current"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$",
      "format": "date-time"
    },
    "credential_file": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
    },
    "protocol_file": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stable_id",
          "underlying_id",
          "network",
          "address"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "underlying_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "network": {
            "enum": [
              "ethereum",
              "solana"
            ]
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "pool_address": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "network": {
                  "const": "ethereum"
                }
              }
            },
            "then": {
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "pool_address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                }
              }
            },
            "else": {
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                },
                "pool_address": {
                  "type": "string",
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                }
              }
            }
          }
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "bytes",
        "seconds",
        "requests_per_minute"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
