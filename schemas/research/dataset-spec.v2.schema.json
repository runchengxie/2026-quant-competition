{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded daily equity specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "version",
    "source",
    "market",
    "products",
    "benchmark",
    "quote_currency",
    "start",
    "end",
    "timezone",
    "calendar",
    "price_basis",
    "universe_status",
    "budget",
    "connection_file",
    "contracts"
  ],
  "properties": {
    "schema": {
      "const": "competition.dataset_spec.v2"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "source": {
      "const": "ibkr_daily"
    },
    "market": {
      "enum": [
        "US",
        "HK"
      ]
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      }
    },
    "benchmark": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "quote_currency": {
      "enum": [
        "USD",
        "HKD"
      ]
    },
    "start": {
      "type": "string",
      "format": "date"
    },
    "end": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "enum": [
        "America/New_York",
        "Asia/Hong_Kong"
      ]
    },
    "calendar": {
      "enum": [
        "XNYS",
        "XHKG"
      ]
    },
    "price_basis": {
      "const": "split_adjusted"
    },
    "universe_status": {
      "const": "fixed_current"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "bytes",
        "seconds"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2400
        }
      }
    },
    "connection_file": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "symbol",
          "exchange",
          "currency",
          "role"
        ],
        "properties": {
          "product": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,19}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,19}$"
          },
          "exchange": {
            "enum": [
              "SMART",
              "SEHK"
            ]
          },
          "currency": {
            "enum": [
              "USD",
              "HKD"
            ]
          },
          "role": {
            "enum": [
              "stock",
              "benchmark"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "market": {
            "const": "US"
          }
        }
      },
      "then": {
        "properties": {
          "quote_currency": {
            "const": "USD"
          },
          "calendar": {
            "const": "XNYS"
          },
          "timezone": {
            "const": "America/New_York"
          },
          "contracts": {
            "items": {
              "properties": {
                "exchange": {
                  "const": "SMART"
                },
                "currency": {
                  "const": "USD"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market": {
            "const": "HK"
          }
        }
      },
      "then": {
        "properties": {
          "quote_currency": {
            "const": "HKD"
          },
          "calendar": {
            "const": "XHKG"
          },
          "timezone": {
            "const": "Asia/Hong_Kong"
          },
          "contracts": {
            "items": {
              "properties": {
                "exchange": {
                  "const": "SEHK"
                },
                "currency": {
                  "const": "HKD"
                }
              }
            }
          }
        }
      }
    }
  ]
}
