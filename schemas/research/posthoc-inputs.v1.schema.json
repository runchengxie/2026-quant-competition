{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "calendar",
    "cohorts",
    "observations",
    "blocks",
    "original_labels"
  ],
  "properties": {
    "schema": {
      "const": "equity.posthoc_inputs.v1"
    },
    "calendar": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cohorts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": "boolean"
          },
          {
            "type": "boolean"
          }
        ],
        "items": false,
        "minItems": 7,
        "maxItems": 7
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model",
          "training_horizon",
          "window",
          "sessions",
          "scores"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "enum": [
              "ridge",
              "elastic_net",
              "shallow_tree",
              "momentum20"
            ]
          },
          "training_horizon": {
            "enum": [
              5,
              20
            ]
          },
          "window": {
            "type": "string"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      },
      "minItems": 16,
      "maxItems": 16
    },
    "original_labels": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "enum": [
              5,
              20
            ]
          },
          {
            "type": [
              "number",
              "null"
            ]
          }
        ],
        "items": false,
        "minItems": 4,
        "maxItems": 4
      }
    }
  }
}
