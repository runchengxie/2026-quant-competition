{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "parent_status",
    "coverage",
    "files",
    "accepted_research",
    "receipt"
  ],
  "properties": {
    "schema": {
      "const": "competition.binance_daily_manifest.v1"
    },
    "plan": {
      "type": "object"
    },
    "parent_status": {
      "type": "string"
    },
    "coverage": {
      "type": "object"
    },
    "files": {
      "type": "array"
    },
    "accepted_research": {
      "const": false
    },
    "receipt": {
      "type": "object"
    }
  }
}
