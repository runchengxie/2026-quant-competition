---
import facts from '../data/incremental-research.v1.json';
import rawFacts from '../data/incremental-research.v1.json?raw';
import en from '../i18n/incremental-en.json';
import zh from '../i18n/incremental-zh-CN.json';
import {formatResearchNumber} from '../scripts/incremental-state.mjs';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const view=Astro.props.view==='crypto'?'crypto':'equity';
const t=locale==='en'?en:zh;
const fmt=(value:number|null)=>formatResearchNumber(value,locale,t.unavailable);
const prefix=`/global-market-research/${locale==='en'?'':'zh-CN/'}`;
const windows=[...new Set(facts.crypto.jobs.map(row=>row.window_id))];
const modelName=(id:string)=>t.models[id as keyof typeof t.models];
const armName=(id:string)=>t.arms[id as keyof typeof t.arms];
---
<section id={`incremental-${view}`} data-incremental-view={view} data-incremental-facts={rawFacts}>
 <h2>{view==='equity'?t.equityTitle:t.cryptoTitle}</h2>
 <p class="conclusion">{view==='equity'?t.equityLead:t.cryptoLead}</p>
 <p>{view==='equity'?t.equityScope:t.cryptoScope}</p>
 <div class="controls">
 {view==='equity'?<>
  <label>{t.model}<select data-model>{['ridge_full','ridge_return_only','ridge_without_return','shallow_tree','reversal','session_return_rank','constant_zero'].map(model=><option value={model}>{modelName(model)}</option>)}</select></label>
  <label>{t.period}<select data-period>{facts.equity.folds.map((fold,index)=><option value={index}>{fold.start} ～ {fold.end}</option>)}</select></label>
 </>:<>
  <label>{t.fee}<select data-fee><option value="35">{t.cost35}</option><option value="50">{t.cost50}</option></select></label>
  <label>{t.window}<select data-window><option value="all">{t.allWindows}</option>{windows.map(window=><option value={window}>{window} ～ {facts.crypto.jobs.find(row=>row.window_id===window)!.end}</option>)}</select></label>
 </>}
 </div>
 <figure><figcaption>{view==='equity'?t.equityChart:t.cryptoChart}</figcaption><div data-incremental-chart role="img" aria-label={view==='equity'?t.equityChart:t.cryptoChart}></div><p class="detail">{view==='equity'?t.equityChartNote:t.cryptoChartNote}</p></figure>
 <p class="detail">{view==='equity'?t.equityExplain:t.cryptoExplain}</p>
 {view==='equity'?<>
  <div class="table-scroll"><table><caption>{t.equityTable}</caption><thead><tr><th scope="col">{t.period}</th><th scope="col">{t.model}</th><th scope="col">{t.ic}</th><th scope="col">{t.mse}</th><th scope="col">{t.coverage}</th></tr></thead><tbody>{facts.equity.folds.flatMap((fold,index)=>fold.models.map(model=><tr data-equity-row data-fold={index}><th scope="row">{fold.start} ～ {fold.end}</th><td>{modelName(model.model)}</td><td>{fmt(model.metrics.mean_daily_ic)}</td><td>{fmt(model.metrics.mean_daily_mse)}</td><td>{model.metrics.valid_ic_dates}/{model.metrics.requested_dates}</td></tr>))}</tbody></table></div>
  <h3>{t.strataTitle}</h3><p class="detail">{t.strataNote}</p>
  <div class="table-scroll"><table><caption>{t.strataTitle}</caption><thead><tr><th scope="col">{t.model}</th><th scope="col">{t.period}</th><th scope="col">{t.dimension}</th><th scope="col">{t.group}</th><th scope="col">{t.ic}</th><th scope="col">{t.coverage}</th><th scope="col">{t.count}</th></tr></thead><tbody>{facts.equity.folds.flatMap((fold,index)=>fold.models.flatMap(model=>model.strata.map(row=><tr data-stratum-row data-fold={index} data-stratum-model={model.model}><th scope="row">{modelName(model.model)}</th><td>{fold.start} ～ {fold.end}</td><td>{t.dimensions[row.dimension as keyof typeof t.dimensions]}</td><td>{t.groups[row.group as keyof typeof t.groups]??row.group}</td><td>{fmt(row.mean_daily_ic)}</td><td>{row.valid_dates}/{row.requested_dates}</td><td>{row.rows}</td></tr>)))}</tbody></table></div>
 </>:<div class="table-scroll"><table><caption>{t.cryptoTable}</caption><thead><tr><th scope="col">{t.window}</th><th scope="col">{t.model}</th><th scope="col">{t.fee}</th><th scope="col">{t.return}</th><th scope="col">{t.drawdown}</th><th scope="col">{t.turnover}</th><th scope="col">{t.exposure}</th><th scope="col">{t.trades}</th></tr></thead><tbody>{facts.crypto.jobs.map(row=><tr data-crypto-row data-row-fee={row.fee_bps} data-row-window={row.window_id}><th scope="row">{row.start} ～ {row.end}</th><td>{armName(row.arm)}</td><td>{row.fee_bps} bps</td><td>{fmt(100*row.metrics.net_return)}</td><td>{fmt(100*row.metrics.max_drawdown)}</td><td>{fmt(row.metrics.turnover)}</td><td>{fmt(100*row.metrics.mean_exposure)}</td><td>{row.actual_rebalances}</td></tr>)}</tbody></table></div>}
 <p class="detail">{t.limit}</p><a href={`${prefix}docs/incremental-research/`}>{t.method} ↗</a>
 <script type="application/json" data-incremental-config set:html={JSON.stringify({locale,t}).replaceAll('<','\\u003c')}/>
</section>
<script>
 document.querySelectorAll('[data-incremental-view]').forEach(root=>{
  const observer=new IntersectionObserver(async entries=>{
   if(!entries.some(entry=>entry.isIntersecting))return;observer.disconnect();
   try{const {mountIncremental}=await import('../scripts/incremental-charts.mjs');mountIncremental(root);}
   catch(error){console.error('Incremental chart unavailable; evidence tables remain available',error);}
  },{rootMargin:'200px'});observer.observe(root);
 });
</script>
<style>
section{margin:1rem 0 4rem;border-top:1px solid var(--line);padding-top:1rem;min-width:0}h2{margin-top:0;max-width:30ch;line-height:1.3}.conclusion{font-size:1.2rem;line-height:1.8;max-width:72ch}.detail{color:var(--muted);font-size:.92rem;line-height:1.8;max-width:85ch}.controls{display:flex;flex-wrap:wrap;gap:1rem;margin:1rem 0}label{display:grid;gap:.4rem;font-size:.85rem;max-width:100%}select{font:inherit;color:var(--ink);background:var(--paper);border:1px solid var(--line);padding:.65rem;max-width:100%}figure{margin:1rem 0;min-width:0}figcaption{font-weight:600}[data-incremental-chart]{height:360px;width:100%;min-width:0;overflow:hidden}.table-scroll{max-width:100%;overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.82rem;font-variant-numeric:tabular-nums}td,th{padding:.65rem;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}caption{text-align:left;margin:1rem 0;font-weight:600}[hidden]{display:none!important}@media(max-width:500px){.controls{display:grid;grid-template-columns:minmax(0,1fr)}[data-incremental-chart]{height:320px}}
</style>
