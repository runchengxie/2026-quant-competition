---
import snapshot from '../data/real-data-study.v1.json';
import {summarizeWindows} from '../scripts/dashboard-state.mjs';
import en from '../i18n/en.json';
import zh from '../i18n/zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const t=(locale==='en'?en:zh).dashboard;const text=t.insights;
const format=new Intl.NumberFormat(locale,{maximumFractionDigits:2});
const pct=(value:number|null)=>value===null?'—':format.format(value*100)+'%';
const prefix=`/2026-quant-competition/${locale==='zh-CN'?'zh-CN/':''}`;
const markets=Object.entries(t.markets).map(([market,label])=>{
 const rows=snapshot.results.filter(r=>r.market===market&&r.status==='completed');
 const feeBps=({US:20,HK:30,crypto:10})[market as "US"|"HK"|"crypto"];
 const strategies=[...new Set(rows.map(r=>r.strategy))].sort();
 return {market,label,feeBps,strategies:strategies.map(strategy=>({strategy,summary:summarizeWindows(snapshot,{market,strategy,feeBps})!}))};
});
---
<section class="research-summary" aria-labelledby="research-summary-title">
 <h2 id="research-summary-title">{text.title}</h2><p>{text.intro}</p>
 <div class="market-summaries">{markets.map(m=><article data-market-summary={m.market}>
  <h3>{m.label} · {m.feeBps} bps · {m.strategies[0].summary.quoteCurrency}</h3>
  <div class="summary-table"><table><thead><tr><th scope="col">{t.strategy}</th><th scope="col">{text.count}</th><th scope="col">{text.positive}</th><th scope="col">{text.median}</th><th scope="col">{text.worst}</th></tr></thead>
  <tbody>{m.strategies.map(({strategy,summary:s})=><tr data-summary-facts={JSON.stringify({market:m.market,strategy,feeBps:m.feeBps,...s})}><th scope="row"><a href={`${prefix}docs/strategies/#${strategy.replaceAll("_","-")}`}>{t.strategies[strategy as keyof typeof t.strategies]}</a></th><td>{s.count}</td><td>{pct(s.positiveExcessRate)} ({s.positiveExcessCount}/{s.excessCount})</td><td>{pct(s.medianNetReturn)}</td><td>{pct(s.worstNetReturn)}</td></tr>)}</tbody></table></div>
 </article>)}</div><p class="detail">{text.caveat}</p>
</section>
<style>
.research-summary{padding:1rem 0 2rem}.market-summaries{display:grid;gap:1rem}.market-summaries article{min-width:0;padding:1rem;border:1px solid var(--line);border-radius:.75rem;background:var(--surface)}h3{margin-top:0}.summary-table{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.85rem}th,td{text-align:left;padding:.65rem;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}thead th{color:var(--muted)}p{color:var(--muted)}
</style>

