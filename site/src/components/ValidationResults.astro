---
import snapshot from "../data/strategy-validation.json";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
interface Props { locale: "en" | "zh-CN" }
const { locale } = Astro.props;
const t = (locale === "zh-CN" ? zh : en).validation;
const percent = new Intl.NumberFormat(locale, { style: "percent", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const number = new Intl.NumberFormat(locale, { maximumFractionDigits: 3 });
const show = (value: number | null, ratio = false) => value === null ? "N/A" : (ratio ? percent : number).format(value);
const evidence = t.evidence as Record<string, string>;
const providers = t.providers as Record<string, string>;
const blocked = t.blocked as Record<string, string>;
const groups = [{ id: "HK", title: t.hk }, { id: "US", title: t.us }, { id: "MULTI", title: t.multi }];
const acceptanceGuide = `https://github.com/runchengxie/global-market-research/blob/main/docs/research/research-acceptance${locale === "zh-CN" ? ".zh-CN" : ""}.md`;
const report = `https://github.com/runchengxie/global-market-research/blob/main/docs/research/strategy-validation-2026-10-19${locale === "zh-CN" ? ".zh-CN" : ""}.md`;
---
<section id="validation" class="validation-section">
  <div class="section-heading"><p class="eyebrow">{t.eyebrow}</p><h2>{t.title}</h2><p>{t.intro}</p></div>
  <p class="detail">{t.limited}</p><p class="detail">{t.cnn}</p>
  {groups.map(group => <div class="result-group"><h3>{group.title}</h3><div class="result-scroll"><table class="results-table"><thead><tr><th>{t.strategy}</th><th>{t.period}</th><th>{t.return}</th><th>{t.sharpe}</th><th>{t.drawdown}</th><th>{t.evidenceLabel}</th></tr></thead><tbody>
    {snapshot.results.filter(row => row.market === group.id).map(row => <tr data-result-id={row.id} data-metrics={JSON.stringify(row.metrics)} data-total-return={row.metrics.total_return ?? "null"} data-evidence={row.evidence}><th scope="row"><code>{row.strategy}</code></th><td>{row.start}<br />{row.end}</td><td>{show(row.metrics.total_return, true)}</td><td>{show(row.metrics.sharpe)}</td><td>{show(row.metrics.max_drawdown, true)}</td><td><span class="result-status">{evidence[row.evidence]}</span></td></tr>)}
  </tbody></table></div></div>)}
  <p class="detail">{t.rootLimit}</p>
  <div class="result-group"><h3>{t.crypto}</h3><p class="detail">{t.cryptoLimit}</p><div class="result-scroll"><table class="results-table"><thead><tr><th>{t.strategy}</th><th>{t.pnl}</th><th>{t.fills}</th><th>{t.inventory}</th><th>{t.evidenceLabel}</th></tr></thead><tbody>
    {snapshot.results.filter(row => row.market === "CRYPTO").map(row => <tr data-result-id={row.id} data-metrics={JSON.stringify(row.metrics)} data-total-return="null" data-evidence={row.evidence}><th scope="row"><code>{row.strategy}</code></th><td>{show(row.metrics.total_pnl)}</td><td>{show(row.metrics.fill_count)}</td><td>{show(row.metrics.max_absolute_inventory)}</td><td><span class="result-status">{evidence[row.evidence]}</span></td></tr>)}
  </tbody></table></div></div>
  <h3>{t.provider}</h3><p class="detail">{t.providerNote}</p><div class="result-scroll"><table class="results-table"><thead><tr><th>{t.provider}</th><th>{t.status}</th><th>{t.history}</th></tr></thead><tbody>{snapshot.providers.map(provider => <tr><th scope="row"><code>{provider.id}</code></th><td>{providers[provider.id]}</td><td>{show(provider.history_observations)}</td></tr>)}</tbody></table></div>
  <p class="detail">{t.gateway}</p><h3>{t.blockedTitle}</h3><ul class="validation-limits">{snapshot.blocked.map(id => <li>{blocked[id]}</li>)}</ul>
  <a class="text-link" href={report}>{t.details} ↗</a>
  <p><a class="text-link" href={acceptanceGuide}>{t.acceptanceGuide} ↗</a></p>
</section>
<style>
.validation-section { border-top: 1px solid var(--line); padding-top: 4rem; }
.result-group { margin: 2rem 0; }
.result-scroll { overflow-x: auto; margin: 1rem 0 1.5rem; }
.results-table { width: 100%; border-collapse: collapse; text-align: left; font-size: .88rem; }
.results-table th, .results-table td { padding: .85rem .7rem; border-bottom: 1px solid var(--line); vertical-align: top; }
.results-table thead { color: var(--table-heading); background: var(--table-bg); }
.results-table tbody th { font-weight: 500; }
.results-table code { font-size: .8rem; }
.result-status { display: inline-block; color: var(--result-ink); background: var(--result-bg); padding: .25rem .5rem; border-radius: .3rem; font-size: .8rem; }
.validation-limits { line-height: 1.8; padding-left: 1.25rem; }
</style>
