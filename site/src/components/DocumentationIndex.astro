---
import SiteNavigation from "./SiteNavigation.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { documents } from "../lib/documents";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
interface Props { locale?:string }
const locale=Astro.props.locale==="zh-CN"?"zh-CN":"en";
const t=(locale==="zh-CN"?zh:en).documents;
const prefix=`/2026-quant-competition/${locale==="zh-CN"?"zh-CN/":""}`;
---
<SiteLayout locale={locale} localePath="docs/" title={`${t.title} | QUANT / LAB`} description={t.intro}>
  <SiteNavigation locale={locale} active="docs" />
  <main><h1>{t.title}</h1><p class="doc-index-intro">{t.intro}</p><div class="doc-cards"><a data-doc-slug="project" href={`${prefix}docs/project/`}><h2>{(locale==="en"?en:zh).pages.titles.guide}</h2><p>{(locale==="en"?en:zh).pages.guideSummary}</p></a>
    {documents.filter(d=>d.locale===locale).map(d=><a data-doc-slug={d.slug} href={d.route}><h2>{t.titles[d.slug as keyof typeof t.titles]}</h2><p>{t.summaries[d.slug as keyof typeof t.summaries]}</p></a>)}
  </div></main>
</SiteLayout>
<style>
main { max-width:1220px; margin:2.5rem auto; padding:0 42px; }
h1 { font-size:clamp(2rem,4vw,2.9rem);line-height:1.4; }
.doc-index-intro{color:var(--muted);max-width:72ch}
.doc-cards { margin:2.5rem 0; }
.doc-cards a { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:2rem;padding:1.3rem 0; border:0;border-top:1px solid var(--line);background:transparent;text-decoration:none; }
.doc-cards h2{font-size:1.2rem;line-height:1.6;margin:0;color:var(--ink)}
.doc-cards a:hover h2{text-decoration:underline;text-underline-offset:5px}
.doc-cards p { color:var(--muted);font-size:.9rem;margin:0; }
@media(max-width:700px) { main{padding-inline:23px}.doc-cards a{grid-template-columns:minmax(0,1fr);gap:.4rem} }
</style>
