---
import SiteNavigation from "./SiteNavigation.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { documents } from "../lib/documents";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
interface Props { locale?:string }
const locale=Astro.props.locale==="zh-CN"?"zh-CN":"en";
const t=(locale==="zh-CN"?zh:en).documents;
const prefix=`/2026-quant-competition/${locale==="zh-CN"?"zh-CN/":""}`;
---
<SiteLayout locale={locale} localePath="docs/" title={`${t.title} | QUANT / LAB`} description={t.intro}>
  <SiteNavigation locale={locale} active="docs" />
  <main><a href={prefix}>QUANT / LAB ↗</a><h1>{t.title}</h1><p>{t.intro}</p><div class="doc-cards"><a data-doc-slug="project" href={`${prefix}docs/project/`}><h2>{(locale==="en"?en:zh).pages.titles.guide}</h2><p>{(locale==="en"?en:zh).pages.guideSummary}</p></a>
    {documents.filter(d=>d.locale===locale).map(d=><a data-doc-slug={d.slug} href={d.route}><h2>{t.titles[d.slug as keyof typeof t.titles]}</h2><p>{t.summaries[d.slug as keyof typeof t.summaries]}</p></a>)}
  </div></main>
</SiteLayout>
<style>
main { max-width:1100px; margin:3rem auto; padding:0 1.25rem; }
h1 { font-size:clamp(2rem,5vw,3.5rem); }
.doc-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin:2rem 0; }
.doc-cards a { padding:1.5rem; border:1px solid var(--line); border-radius:.75rem; background:var(--surface); text-decoration:none; }
.doc-cards p { color:var(--muted); }
@media(max-width:600px) { .doc-cards { grid-template-columns:minmax(0,1fr); } }
</style>
