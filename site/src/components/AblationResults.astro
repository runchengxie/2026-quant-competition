---
import {loadAblation} from "../lib/ablation";
import {summarizeAblations} from "../scripts/ablation-state.mjs";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
interface Props {locale?:string}
const locale=Astro.props.locale==="zh-CN"?"zh-CN":"en";
const t=(locale==="zh-CN"?zh:en).ablation;
const snapshot=loadAblation();
const prefix=`/global-market-research/${locale==="zh-CN"?"zh-CN/":""}`;
const number=new Intl.NumberFormat(locale,{maximumFractionDigits:2,minimumFractionDigits:2});
const show=(v:number|null)=>v===null?"—":`${number.format(v*100)}%`;
const variant=(id:string)=>t.variants[id as keyof typeof t.variants]??id;
const role=(id:string)=>t.roles[id as keyof typeof t.roles]??id;
const columns=[t.strategy,t.variant,t.fee,t.count,t.net,t.excess,t.paired,t.drawdown,t.turnover,t.exposure];
const groups=snapshot?summarizeAblations(snapshot,{market:"US",feeBps:20}):[];
---
<section id="ablation" class="ablation-section" data-ready={snapshot?"pending":"unavailable"}>
 <div class="ablation-heading"><div><p class="eyebrow">{t.eyebrow}</p><h2>{t.title}</h2><p>{t.intro}</p></div><a href={`${prefix}docs/strategies/#formal-ablation`}>{t.guide} ↗</a></div>
 <p class="ablation-limit">{t.limitation}</p>
 {snapshot?<>
  <p class="ablation-role-note" data-ablation-role-note><span class="role-badge" data-ablation-role="post_hoc_diagnostic">{t.roles.post_hoc_diagnostic}</span> {t.roleNote}</p>
  <dl class="ablation-counts"><div><dt>{t.coverage}</dt><dd>{snapshot.results.length}</dd></div><div><dt>{t.baseline}</dt><dd>{snapshot.results.filter((r:any)=>r.variant_id==="baseline").length}</dd></div><div><dt>{t.policies}</dt><dd>{new Set(snapshot.results.filter((r:any)=>r.variant_id&&r.variant_id!=="baseline").map((r:any)=>r.variant_id)).size}</dd></div></dl>
  <div class="ablation-controls" data-ablation-controls hidden>
   <label>{t.market}<select data-ablation-filter="market">{(["US","HK","crypto"] as const).map(m=><option value={m}>{t.markets[m]}</option>)}{snapshot.results.some((r:any)=>r.market==="unknown")&&<option value="unknown">{t.markets.unknown}</option>}</select></label>
   <label>{t.fee}<select data-ablation-filter="fee" /></label>
   <label>{t.strategy}<select data-ablation-filter="strategy" /></label>
   <label>{t.variant}<select data-ablation-filter="variant" /></label>
   <label>{t.window}<select data-ablation-filter="window" /></label>
  </div>
  <p data-ablation-status aria-live="polite">{t.summaryNote}</p>
  <div class="ablation-charts"><figure><figcaption>{t.pairedChart}</figcaption><div data-ablation-chart="paired" class="chart-root" role="img" aria-label={t.pairedChart}></div><p>{t.summaryNote}</p></figure><figure><figcaption>{t.riskChart}</figcaption><div data-ablation-chart="risk" class="chart-root" role="img" aria-label={t.riskChart}></div><p>{t.riskNote}</p></figure></div>
  <h3>{t.summary}</h3><div class="ablation-scroll" tabindex="0" aria-label={t.summary}><table><thead><tr>{columns.map(label=><th>{label}</th>)}</tr></thead><tbody data-ablation-summary>{groups.map((g:any)=><tr><th>{g.strategy}</th><td>{variant(g.variant_id)}<br/><span class="role-badge">{role(g.evidence_role)}</span></td><td>{g.cost_bps}</td><td>{g.count}</td>{[g.median_net_return,g.median_excess_return,g.median_paired_net_change,g.median_paired_drawdown_change,g.median_daily_turnover,g.median_exposure].map(v=><td>{show(v)}</td>)}</tr>)}</tbody></table></div>
  <h3>{t.facts}</h3>
  {(["US","HK","crypto","unknown"] as const).map(market=><details data-ablation-market={market}><summary>{t.markets[market]}</summary><div class="ablation-scroll" tabindex="0" aria-label={`${t.markets[market]} ${t.facts}`}><table><thead><tr>{[t.strategy,t.variant,t.period,t.fee,t.returnLabel,t.drawdownLabel,t.pairedLabel,t.status].map(label=><th>{label}</th>)}</tr></thead><tbody>{snapshot.results.filter((r:any)=>r.market===market).map((r:any)=><tr data-ablation-id={r.job_id} data-facts={JSON.stringify(r)}><th scope="row"><code>{r.strategy??"—"}</code></th><td>{r.variant_id?variant(r.variant_id):"—"}{r.evidence_role&&<><br/><span class="role-badge" data-ablation-role={r.evidence_role}>{role(r.evidence_role)}</span></>}</td><td>{r.start??"—"}<br/>{r.end??"—"}</td><td>{r.cost_bps??"—"}</td><td>{show(r.net_return)}</td><td>{show(r.max_drawdown)}</td><td>{show(r.paired_net_change)}</td><td>{t[r.status as "completed"|"blocked"|"failed"]}{r.reason_code&&<><br/><code>{r.reason_code}</code></>}</td></tr>)}</tbody></table></div></details>)}
  <details><summary>{t.provenance}</summary><p>{snapshot.as_of}</p><p><code>{snapshot.code_commit}</code><br/><code>{snapshot.plan_sha256}</code><br/><code>{snapshot.catalog_sha256}</code></p></details>
  <a href={`${prefix}docs/strategies/#forward-observation`}>{t.readiness} ↗</a>
  <script type="application/json" data-ablation-config set:html={JSON.stringify({locale,t}).replace(/</g,"\\u003c")} />
 </>:<p>{t.unavailable}</p>}
</section>
<script>
 const root=document.getElementById("ablation");
 if(root?.dataset.ready==="pending"){
  const observer=new IntersectionObserver(async entries=>{
   if(!entries.some(e=>e.isIntersecting))return;observer.disconnect();
   try{const {mountAblationCharts}=await import("../scripts/ablation-charts.mjs");mountAblationCharts(root);}
   catch(error){const config=JSON.parse(root.querySelector("[data-ablation-config]")!.textContent!);root.querySelector("[data-ablation-status]")!.textContent=config.t.loadError;root.dataset.ready="error";console.error("Ablation charts could not load",error);}
  },{rootMargin:"200px"});observer.observe(root);
 }
</script>
<style>
.ablation-section{border-top:1px solid var(--line);padding:3rem 0}.ablation-heading{display:flex;justify-content:space-between;gap:1rem}.ablation-heading>a{flex-shrink:0;align-self:center}.ablation-limit{border-left:3px solid var(--green);padding-left:1rem}.ablation-role-note{padding:1rem;background:var(--surface);border:1px solid var(--line);border-radius:.5rem}.ablation-counts{display:flex;gap:3rem;flex-wrap:wrap}.ablation-counts dt{color:var(--muted);font-size:.85rem}.ablation-counts dd{margin:0;font-size:2rem;font-variant-numeric:tabular-nums}.ablation-controls{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem;border:1px solid var(--line);border-radius:.6rem;padding:1rem}.ablation-controls[hidden]{display:none}.ablation-controls label{display:grid;gap:.4rem;font-size:.85rem;min-width:0}.ablation-controls select{width:100%;padding:.6rem .3rem;color:var(--ink);background:var(--paper);border:1px solid var(--line);font:inherit;border-radius:.3rem}.ablation-charts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.ablation-charts figure{margin:0;border:1px solid var(--line);border-radius:.6rem;padding:1rem;min-width:0}.ablation-charts figcaption{font-weight:650}.ablation-charts figure>p{font-size:.8rem;color:var(--muted)}.chart-root{overflow:hidden;height:340px;width:100%;margin-top:.8rem}.ablation-scroll{overflow-x:auto;margin:1rem 0}table{width:100%;min-width:66rem;border-collapse:collapse;text-align:left;font-size:.82rem}td,th{padding:.7rem .5rem;border-bottom:1px solid var(--line);vertical-align:top}thead{color:var(--table-heading);background:var(--table-bg)}.role-badge{font-size:.7rem;color:var(--muted);display:inline-block;padding:.15rem .3rem;border:1px solid var(--line);border-radius:.25rem;margin-top:.25rem}details{border-bottom:1px solid var(--line);padding:.5rem 0}summary{cursor:pointer;padding:.5rem 0}code{overflow-wrap:anywhere}tr[hidden],details[hidden]{display:none}@media(max-width:850px){.ablation-controls{grid-template-columns:repeat(2,minmax(0,1fr))}.ablation-charts{grid-template-columns:minmax(0,1fr)}}@media(max-width:500px){.ablation-heading{display:block}.ablation-controls{grid-template-columns:minmax(0,1fr)}.ablation-counts{gap:1.5rem}}
</style>
