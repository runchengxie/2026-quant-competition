---
import SiteNavigation from "./SiteNavigation.astro";
import FactorResearch from "./FactorResearch.astro";
import PredictiveResearch from "./PredictiveResearch.astro";
import IncrementalResearch from "./IncrementalResearch.astro";
import ResearchComparison from "./ResearchComparison.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import ValidationResults from "./ValidationResults.astro";
import ExpansionResults from "./ExpansionResults.astro";
import AblationResults from "./AblationResults.astro";
import StrategyControls from "./StrategyControls.astro";
import RobustnessResults from "./RobustnessResults.astro";
import EditorialHome from "./EditorialHome.astro";
import StudyResults from "./StudyResults.astro";
import ResearchSummary from "./ResearchSummary.astro";
import PerformanceDashboard from "./PerformanceDashboard.astro";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
import incrementalEn from "../i18n/incremental-en.json";
import incrementalZh from "../i18n/incremental-zh-CN.json";
import comparisonEn from "../i18n/comparison-en.json";
import comparisonZh from "../i18n/comparison-zh-CN.json";
interface Props { locale?: string; view?: "home"|"strategies"|"factors"|"guide" }
const locale = Astro.props.locale === "zh-CN" ? "zh-CN" : "en";
const t = locale === "zh-CN" ? zh : en;
const incrementalText = locale === "zh-CN" ? incrementalZh : incrementalEn;
const comparisonText = locale === "zh-CN" ? comparisonZh : comparisonEn;
const view=Astro.props.view??"home";
const prefix=`/2026-quant-competition/${locale==='en'?'':'zh-CN/'}`;
const localePath=({home:'',strategies:'strategies/',factors:'factors/',guide:'docs/project/'})[view];
const legacy={performance:'strategies/#performance',ablation:'strategies/#ablation',study:'strategies/#study',evidence:'docs/project/#evidence',demo:'docs/project/#demo',research:'docs/project/#research',engineering:'docs/project/#engineering',validation:'docs/project/#validation',expansion:'docs/project/#expansion'};
Object.assign(legacy,{'title-stock':'docs/project/#title-stock','title-crypto':'docs/project/#title-crypto','research-summary-title':'docs/project/#research-summary-title','research-history':'#takeaways'});
const repository = "https://github.com/runchengxie/2026-quant-competition";
const docsUrl=`/2026-quant-competition/${locale==="zh-CN"?"zh-CN/":""}docs/`;
const file = (path: string) => `${repository}/blob/main/${path}`;
const numbers = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const closes = [100.0, 100.3, 100.6, 100.9, 101.2, 101.5, 101.8];
const points = closes.map((value, index) => `${20 + index * 50},${140 - (value - 100) * 55}`).join(" ");
const paths = [
  { id: "stock", directory: "equity-lab", text: t.stock, commands: "cd research/equity-lab\nuv sync --locked --group dev\nuv run --locked python -m equity_lab.cli demo\nuv run --locked python -m equity_lab.cli backtest --strategy equal_weight" },
  { id: "crypto", directory: "crypto-mm", text: t.crypto, commands: "cd research/crypto-mm\nuv sync --locked --group dev\nuv run --locked python -m crypto_mm.demo\nuv run --locked python -m crypto_mm.commands.backtest_cli --strategy B0 --days 2026-03-19" },
];
const guide = (directory: string) => file(`research/${directory}/README${locale === "zh-CN" ? ".zh-CN" : ""}.md`);
---
<SiteLayout locale={locale} localePath={localePath} title={`${view==="home"?t.meta.title:t.pages.titles[view]} | QUANT / LAB`} description={view==="home"?t.meta.description:t.pages.intros[view]}>
  <SiteNavigation locale={locale} active={view==="guide"?"docs":view} />
  <main class:list={['showcase-main',`view-${view}`]}>
  {view!=='home'&&<header class="showcase-hero performance-hero"><div>
    <h1>{t.pages.titles[view]}</h1>
    <p class="intro">{view==='home'?t.hero.intro:t.pages.intros[view]}</p><p class="hero-note">{t.hero.note}</p>
  </div></header>}
    {view==='home'&&<EditorialHome locale={locale} />}
    {view==='strategies'&&<>
      <nav class="section-nav" aria-label={t.strategyControls.headlines.navigation}>
        <a href="#comparison-crypto"><span>01</span>{comparisonText.cryptoTitle}</a>
        <a href="#incremental-crypto"><span>02</span>{incrementalText.latest}</a>
        {['robustness','strategy-controls','ablation','performance','study'].map((id,index)=><a href={`#${id}`}><span>0{index+3}</span>{index===0?t.robustness.title:t.strategyControls.headlines.sections[index-1]}</a>)}
      </nav>
      <ResearchComparison locale={locale} market="crypto" />
      <IncrementalResearch locale={locale} view="crypto" />
      <RobustnessResults locale={locale} /><StrategyControls locale={locale} /><AblationResults locale={locale} /><PerformanceDashboard locale={locale} /><StudyResults locale={locale} />
    </>}
    {view==='factors'&&<><ResearchComparison locale={locale} market="equity" /><IncrementalResearch locale={locale} view="equity" /><PredictiveResearch locale={locale} /><FactorResearch locale={locale} /></>}
    {view==='guide'&&<>    <section id="evidence" class="evidence-section">
      <div class="section-heading"><h2>{t.evidence.title}</h2><p>{t.evidence.intro}</p></div>
      <p class="detail">{t.evidence.scope}</p>
      <h3>{t.evidence.glossaryTitle}</h3><dl class="reader-glossary">{t.evidence.glossary.map(([term,meaning])=><div><dt>{term}</dt><dd>{meaning}</dd></div>)}</dl>
      <details class="baseline-summary"><summary>{t.evidence.baseline}</summary><ResearchSummary locale={locale} /></details>
      <ValidationResults locale={locale} />
      <ExpansionResults locale={locale} />
    </section>
    <section id="demo" class="demo-section">
      <div class="section-heading"><p class="eyebrow">{t.demo.eyebrow}</p><h2>{t.demo.title}</h2><p>{t.demo.intro}</p></div>
      <div class="demo-switcher">
        <fieldset class="path-picker"><legend class="visually-hidden">{t.demo.legend}</legend>
          <input type="radio" name="research-path" id="path-stock" value="stock" checked /><label for="path-stock">{t.demo.stock}</label>
          <input type="radio" name="research-path" id="path-crypto" value="crypto" /><label for="path-crypto">{t.demo.crypto}</label>
        </fieldset>
        {paths.map((path) => <article class={`demo-panel panel-${path.id}`} aria-labelledby={`title-${path.id}`}>
          <div class="demo-overview">
            <div><p class="pill">{t.demo.synthetic}</p><h3 id={`title-${path.id}`}>{path.text.title}</h3><p>{path.text.description}</p><p class="detail">{path.text.sampleDetail}</p></div>
            <figure class="sample-figure"><figcaption>{path.text.sample}</figcaption>
              {path.id === "stock" ? <>
                <svg viewBox="0 0 340 170" role="img" aria-label={`${t.stock.sample}: ${closes.map(v => numbers.format(v)).join(", ")}`}>
                  <path class="chart-grid" d="M20 40H320 M20 90H320 M20 140H320" />
                  <polyline class="sample-line" points={points} />
                  {closes.map((value,index) => <circle cx={20+index*50} cy={140-(value-100)*55} r="4" />)}
                </svg><div class="sample-values"><span>{numbers.format(closes[0])}</span><span>{t.labels.price}</span><span>{numbers.format(closes[6])}</span></div>
              </> : <div class="order-book"><div class="book-side bid"><span>{t.labels.bid}</span><strong>{numbers.format(99.9)}</strong><span class="book-depth" /></div><div class="book-divider">{t.labels.level}</div><div class="book-side ask"><span>{t.labels.ask}</span><strong>{numbers.format(100.1)}</strong><span class="book-depth" /></div></div>}
              <p class="sample-caption">{t.demo.sampleNote}</p>
            </figure>
          </div>
          <h4>{t.demo.pipeline}</h4><ol class="flow">{path.text.steps.map((step,index) => <li><span class="step-number">0{index+1}</span>{step}</li>)}</ol>
          <div class="demo-bottom"><div><h4>{t.demo.outputs}</h4><ul class="artifact-list">{path.text.artifacts.map(item => <li>{item}</li>)}</ul><p class="assumption-label">{t.labels.assumptions}</p><p class="detail">{path.text.limit}</p></div>
          <div class="run-card"><h4>{t.demo.run}</h4><p>{t.demo.setup}</p><pre><code>{path.commands}</code></pre><div class="resource-links"><a href={guide(path.directory)}>{t.demo.guide} ↗</a><a href={`${repository}/tree/main/research/${path.directory}/src`}>{t.demo.source} ↗</a></div></div></div>
        </article>)}
      </div>
    </section>
    <section id="research">
      <div class="section-heading"><p class="eyebrow">{t.research.eyebrow}</p><h2>{t.research.title}</h2><p>{t.research.intro}</p></div>
      <div class="research-grid"><article class="research-card"><span class="status">{t.research.stockStatus}</span><h3>{t.research.stockTitle}</h3><p>{t.research.stockBody}</p><a href={file("docs/strategy/strategy-analysis.md")}>{t.research.stockLink} ↗</a></article><article class="research-card"><span class="status implemented">{t.research.cryptoStatus}</span><h3>{t.research.cryptoTitle}</h3><p>{t.research.cryptoBody}</p><a href={file(`research/crypto-mm/docs/assumptions${locale === "zh-CN" ? ".zh-CN" : ""}.md`)}>{t.research.cryptoLink} ↗</a></article></div>
    </section>
    <section id="engineering" class="engineering-section"><p class="eyebrow">{t.engineering.eyebrow}</p><h2>{t.engineering.title}</h2><p>{t.engineering.body}</p><ol class="flow execution-flow">{t.engineering.stages.map((step,index) => <li><span class="step-number">0{index+1}</span>{step}</li>)}</ol><p class="detail">{t.engineering.warning}</p><a href={file("docs/operations/integration-readiness-2026-10-02.md")}>{t.engineering.link} ↗</a></section>
    <aside class="competition-note"><div><h3>{t.rules.title}</h3><p>{t.rules.body}</p></div><a href={file("docs/competition/schedule-and-checklist.md")}>{t.rules.link} ↗</a></aside>
</>}
  </main>
  {view==='home'&&<script is:inline define:vars={{prefix,legacy}}>
    const followLegacy=()=>{
      let key;try{key=decodeURIComponent(location.hash.slice(1));}catch{return;}
      if(Object.hasOwn(legacy,key)){location.replace(prefix+legacy[key]);return;}
      const target=document.getElementById(key);
      if(target){for(let ancestor=target.parentElement;ancestor;ancestor=ancestor.parentElement){if(ancestor.tagName==='DETAILS')ancestor.open=true;}requestAnimationFrame(()=>target.scrollIntoView());}
    };
    followLegacy();window.addEventListener('hashchange',followLegacy);
  </script>}
  {view==='guide'&&<script is:inline>
    const revealTarget=()=>{
      const key=location.hash.slice(1);
      if(key==='title-crypto'||key==='title-stock')document.getElementById(key==='title-crypto'?'path-crypto':'path-stock').checked=true;
      if(key==='research-summary-title')document.querySelector('.baseline-summary').open=true;
      if(['title-crypto','title-stock','research-summary-title'].includes(key))requestAnimationFrame(()=>document.getElementById(key).scrollIntoView());
    };
    revealTarget();window.addEventListener('hashchange',revealTarget);
  </script>}
  <footer><span>{t.footer.project}</span><span>{t.footer.note}</span></footer>
</SiteLayout>

<style>
.showcase-main.view-strategies>.section-nav{margin-bottom:1rem;padding-bottom:.6rem}
.showcase-hero.performance-hero{padding-top:0;padding-bottom:1rem}.performance-hero h1{font-size:clamp(1.9rem,3vw,2.5rem);line-height:1.2;max-width:58rem}.performance-hero .hero-actions{margin-top:1.1rem}.performance-hero .hero-note{margin:.3rem 0 0}
.evidence-section{border-top:1px solid var(--line);padding-top:2rem}.reader-glossary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.reader-glossary div{border-left:2px solid var(--line);padding-left:1rem}.reader-glossary dt{font-weight:650}.reader-glossary dd{margin:.4rem 0;color:var(--muted)}.baseline-summary{margin:2rem 0}.baseline-summary>summary{cursor:pointer;padding:1rem;border:1px solid var(--line);border-radius:.5rem}@media(max-width:700px){.reader-glossary{grid-template-columns:1fr}}
</style>
