---
import en from '../i18n/en.json';
import zh from '../i18n/zh-CN.json';
import DexFactorResults from './DexFactorResults.astro';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const all=locale==='en'?en:zh;const t=all.factors;
const prefix=`/global-market-research/${locale==='en'?'':'zh-CN/'}`;
const signals=['momentum_20d','sma_cross','momentum_63d','trend_200d'] as const;
const market=Astro.props.market??'all';
const chosen=signals.map((id,index)=>({id,index})).filter(({index})=>market==='all'||(market==='crypto'?index>=2:index<2));
---
<section id={market==='crypto'?'factor-research-crypto':'factor-research'}><h2>{t.title}</h2><p class="lead">{t.conclusion}</p><p class="factor-note">{t.boundary}</p>
 <div class="signal-grid">{chosen.map(({id,index})=><article data-factor-signal={id}><p>{t.markets[index]}</p><h3>{all.dashboard.strategies[id]}</h3><p>{all.dashboard.descriptions[id]}</p><p class="factor-status" data-factor-status>{t.status}</p><a href={`${prefix}strategies/`}>{t.strategyLink} ↗</a></article>)}</div>
 <h2>{t.testsTitle}</h2><dl>{t.tests.map(([title,description])=><div><dt>{title}</dt><dd>{description}</dd></div>)}</dl>
 <p>{t.noResults}</p><a href={`${prefix}docs/strategies/`}>{t.method} ↗</a>
</section>
{market!=='equity'&&<DexFactorResults locale={locale}/>}
<style>
.lead{font-size:1.1rem;max-width:75ch}.factor-note{border-top:1px solid var(--line);padding:1rem 0;color:var(--muted);font-size:.9rem}.signal-grid{margin:2rem 0}.signal-grid article{padding:1.4rem 0;border-top:1px solid var(--line);background:transparent;display:grid;grid-template-columns:1fr 2fr;gap:.5rem 2rem}.signal-grid h3{font-size:1.15rem;margin:0}.signal-grid article>p:first-child{color:var(--muted);font-size:.8rem;margin:0}.signal-grid article>p:nth-of-type(2){grid-column:2;margin:0}.signal-grid a{grid-column:2;font-size:.85rem}.factor-status{color:var(--muted);font-size:.85rem;margin:0}dl{display:grid;gap:1rem}dt{font-weight:600}dd{margin:.4rem 0;color:var(--muted)}@media(max-width:700px){.signal-grid article{grid-template-columns:1fr;gap:.6rem}.signal-grid article>p:nth-of-type(2),.signal-grid a{grid-column:1}}
</style>
