---
import en from '../i18n/home-en.json';
import zh from '../i18n/home-zh-CN.json';
import marketsEn from '../i18n/market-topics-en.json';
import marketsZh from '../i18n/market-topics-zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const t=locale==='zh-CN'?zh:en;
const markets=(locale==='zh-CN'?marketsZh:marketsEn).markets;
const prefix=`/2026-quant-competition/${locale==='en'?'':'zh-CN/'}`;
---
<section id="robustness" class="home">
 <header class="hero"><p class="eyebrow">QUANT / LAB</p><h1>{t.title}</h1><p class="lead">{t.intro}</p><p class="scope" data-scope>{t.scope}</p></header>
 <div id="takeaways" class="directory"><div class="heading"><h2 id="takeaways-title">{t.markets}</h2><a href={`${prefix}markets/`}>{t.allMarkets} →</a></div>
  <div class="market-grid">{markets.map((market,index)=><article id={market.id==='us'?'strategy-controls':undefined} data-market-topic={market.id==='us'?'US':market.id==='hk'?'HK':'crypto'}><p class="number">0{index+1}</p><h3><a data-home-market={market.id} href={`${prefix}markets/#market-${market.id}`}>{market.name} →</a></h3><p>{market.description}</p></article>)}</div>
 </div>
 <section class="featured"><div class="heading"><h2>{t.featured}</h2></div><div class="feature-grid">
  <article data-home-feature><p class="eyebrow">{t.usLabel}</p><h3><a href={`${prefix}strategies/#market-us`}>{t.usTitle}</a></h3><p>{t.usBody}</p><p class="detail">{t.usLimit}</p></article>
  <article data-home-feature><p class="eyebrow">{t.cnnLabel}</p><h3><a data-cnn-note href={`${prefix}research/cnn-chart/`}>{t.cnnTitle}</a></h3><p>{t.cnnBody}</p><p class="detail">{t.cnnLimit}</p></article>
 </div></section>
 <div class="guide"><h2>{t.more}</h2><p>{t.moreBody}</p><a data-run-guide href={`${prefix}docs/project/#demo`}>{t.guide} →</a> · <a id="research-progress-title" href={`${prefix}strategies/#research-progress-title`}>{t.progress} →</a></div>
</section>
<style>
 .home{margin:0}.hero{padding:3rem 0;border-bottom:1px solid var(--ink);max-width:85ch}.eyebrow,.number{font-size:.78rem;color:var(--muted);letter-spacing:.04em}.hero h1{font:400 clamp(2rem,4vw,3.4rem)/1.35 Georgia,'SimSun',serif;max-width:23ch}.lead{font-size:1.15rem;line-height:1.85}.scope,.detail{color:var(--muted);font-size:.85rem;line-height:1.8}.directory,.featured,.guide{margin:0;padding:2.5rem 0;border-bottom:1px solid var(--line)}.heading{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}.heading h2,.guide h2{font:400 1.6rem/1.4 Georgia,'SimSun',serif}.heading a,.guide a,.home h3 a{color:var(--ink)}.market-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.market-grid article,.feature-grid article{padding:1.3rem;border:1px solid var(--line);background:var(--surface);min-width:0}.market-grid h3,.feature-grid h3{font-size:1.2rem;line-height:1.5}.market-grid p,.feature-grid p,.guide p{line-height:1.8}.market-grid article>p:last-child,.feature-grid article>p:not(.eyebrow){color:var(--muted)}.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.detail{border-top:1px solid var(--line);padding-top:.8rem;margin-bottom:0}.guide{border-bottom:0}.guide p{max-width:70ch;color:var(--muted)}@media(max-width:700px){.hero{padding:2rem 0}.market-grid,.feature-grid{grid-template-columns:1fr}.heading{align-items:flex-start;flex-direction:column;gap:0}.directory,.featured,.guide{padding:1.8rem 0}}
</style>
