---
import snapshot from '../data/dex-factor-readiness.v1.json';
import en from '../i18n/en.json';
import zh from '../i18n/zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const t=(locale==='en'?en:zh).dexFactors;
const prefix=`/2026-quant-competition/${locale==='en'?'':'zh-CN/'}`;
if(snapshot.status!=='readiness_only'||'metrics' in snapshot) throw new Error('Unreviewed measured DEX presentation');
const signals=['momentum_24h','momentum_168h','volume_ratio_24h_7d','momentum_volume_24h'];
---
<section id="dex-factor-pilot" data-dex-facts={JSON.stringify(snapshot)} aria-labelledby="dex-factor-title">
 <h2 id="dex-factor-title">{t.title}</h2><p class="lead">{t.conclusion}</p>
 <p class="status">{t.status}</p><p>{t.permission}</p><p>{t.scope}</p>
 <ul>{signals.map((id,index)=><li data-dex-signal={id}><code>{id}</code> <span>{t.signals[index]}</span></li>)}</ul>
 <details><summary>{t.details}</summary>
  <p>{t.request}</p><p>{t.range}: <time>{snapshot.range.start}</time> → <time>{snapshot.range.end}</time></p>
  <p>{t.selection}</p><ul class="assets">{snapshot.asset_ids.map(id=><li><code>{id}</code></li>)}</ul>
  <p>{t.limits}</p><dl><dt>{t.protocol}</dt><dd><code>{snapshot.protocol_sha256}</code></dd><dt>{t.source}</dt><dd><code>{snapshot.source_commit}</code></dd></dl>
 </details>
 <a href={`${prefix}docs/datasets/#dexpaprika-hourly-pilot`}>{t.guide} ↗</a>
 <p class="attribution">Powered by <a href="https://docs.dexpaprika.com/tutorials/token-ohlcv">DexPaprika</a></p>
</section>
<style>
section{margin:3rem 0;padding:1.5rem;border:1px solid var(--line);border-radius:.75rem;background:var(--surface);min-width:0}.lead{font-size:1.15rem}.status{font-weight:650}p,li,dd{overflow-wrap:anywhere}li{margin:.65rem 0}li span{display:block;color:var(--muted)}summary{cursor:pointer;padding:1rem 0;font-weight:650}.assets{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;padding-left:1.25rem}dl{font-size:.85rem}dd{margin:.4rem 0 1rem}.attribution{font-size:.85rem;color:var(--muted)}@media(max-width:700px){section{padding:1rem}}
</style>
