---
import snapshot from '../data/ablation-study.v1.json';
import {summarizeAblations,selectAblations} from '../scripts/ablation-state.mjs';
import en from '../i18n/en.json';
import zh from '../i18n/zh-CN.json';
const locale=Astro.props.locale==='zh-CN'?'zh-CN':'en';
const market=Astro.props.market as string|undefined;
const compact=Astro.props.compact??false;
const prefix=`/global-market-research/${locale==='en'?'':'zh-CN/'}`;
const t=(locale==='en'?en:zh).reader;
const percent=new Intl.NumberFormat(locale,{style:'percent',minimumFractionDigits:2,maximumFractionDigits:2});
const choices=[{market:'US',feeBps:20,strategy:'sma_cross',variant:'weekly'},{market:'HK',feeBps:30,strategy:'momentum_20d',variant:'monthly'},{market:'crypto',feeBps:10,strategy:'trend_200d',variant:'vol_target_40pct'}];
const cards=choices.map((choice,index)=>{
 const groups=summarizeAblations(snapshot,choice);
 const baseline=groups.find(g=>g.variant_id==='baseline')!;
 const candidate=groups.find(g=>g.variant_id===choice.variant)!;
 const drawdown=(variantId:string)=>Math.max(...selectAblations(snapshot,{...choice,variantId}).filter(r=>r.status==='completed').map(r=>r.max_drawdown));
 return {...choice,index,baseline,candidate,before:index===2?drawdown('baseline'):baseline.median_net_return,after:index===2?drawdown(choice.variant):candidate.median_net_return};
}).filter(c=>!market||c.market===market);
---
<section id={market?`takeaway-${market}`:'takeaways'} class:list={['research-takeaways',{'takeaway-compact':compact}]} aria-labelledby={compact?undefined:'takeaways-title'}>
 {!compact&&<><p class="eyebrow">{t.eyebrow}</p><h2 id="takeaways-title">{t.title}</h2><p class="lead">{t.conclusion}</p><p class="scope" data-scope>{t.scope}</p></>}
 <div class="takeaway-grid">{cards.map(c=><article data-takeaway={c.market} data-facts={JSON.stringify({market:c.market,feeBps:c.feeBps,strategy:c.strategy,variant:c.variant,baseline:c.baseline,candidate:c.candidate})}>
  <p class="market-label">{t.cards[c.index].market}</p><h3>{t.cards[c.index].title}</h3><p>{t.cards[c.index].description}</p>
  <p class="metric-label">{c.index===2?t.drawdown:t.net}</p><p class="change"><span>{percent.format(c.before)}</span><span aria-hidden="true"> → </span><strong>{percent.format(c.after)}</strong></p>
  <p class="conditions">{t.before} → {t.after} · {c.candidate.count} {t.windows} · {t.fee} {percent.format(c.feeBps/10000)}</p>
  <p class="caution">{t.cards[c.index].caution}</p><a href={`${prefix}strategies/#ablation`}>{t.compare} ↓</a>
 </article>)}</div>
 {!compact&&<><p class="scope">{t.readNumbers}</p><nav class="reading-path" aria-label={t.path}><a href={`${prefix}strategies/#ablation`}>{t.explore}</a><a href={`${prefix}strategies/#performance`}>{t.curves}</a><a href={`${prefix}docs/project/#evidence`}>{t.evidence}</a><a href={`${prefix}docs/project/#demo`}>{t.run}</a></nav></>}
</section>
<style>
.takeaway-compact .takeaway-grid{display:block;margin:.8rem 0 0}.takeaway-compact .takeaway-grid article{border:0;border-radius:0;padding:0;background:transparent}.takeaway-compact .market-label{display:none}.takeaway-compact .takeaway-grid h3{font-size:1rem}.takeaway-compact .takeaway-grid p{font-size:.85rem}.takeaway-compact .takeaway-grid .change{font:400 1.6rem/1.6 Georgia,'SimSun',serif}.takeaway-compact .metric-label{margin:1rem 0 .2rem}.takeaway-compact .caution{border:0;padding:0}
#takeaways{padding:0 0 2rem}.lead{font-size:1.2rem;max-width:65rem}.scope{color:var(--muted);max-width:70rem}.takeaway-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.takeaway-grid article{min-width:0;border:1px solid var(--line);border-radius:.8rem;padding:1.25rem;background:var(--surface)}.market-label{color:var(--green);font-weight:700;margin:0}.takeaway-grid h3{font-size:1.25rem;margin:.65rem 0}.metric-label{font-size:.85rem;margin:1.5rem 0 .2rem;color:var(--muted)}.change{font-variant-numeric:tabular-nums;font-size:1.9rem;margin:.2rem 0}.change>span:first-child{color:var(--muted)}.conditions{font-size:.8rem;color:var(--muted)}.caution{border-top:1px solid var(--line);padding-top:1rem}.reading-path{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.5rem}.reading-path a{border:1px solid var(--line);border-radius:2rem;padding:.6rem 1rem}@media(max-width:900px){.takeaway-grid{grid-template-columns:1fr}}
</style>
