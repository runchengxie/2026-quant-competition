---
import snapshot from "../data/strategy-controls.v1.json";
import readiness from "../data/strategy-readiness.v1.json";
import {validateControlsSnapshot, summarizeControls, controlsHighlights} from "../scripts/strategy-controls-state.mjs";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
interface Props {locale?:string;compact?:boolean}
const compact=Astro.props.compact??false;
const locale=Astro.props.locale==="zh-CN"?"zh-CN":"en";
const t=(locale==="zh-CN"?zh:en).strategyControls;
validateControlsSnapshot(snapshot);
const prefix=`/2026-quant-competition/${locale==='en'?'':'zh-CN/'}`;
const number=new Intl.NumberFormat(locale,{maximumFractionDigits:2});
const percent=(v:number)=>`${number.format(v*100)}%`;
const date=(v:string|null)=>v?new Intl.DateTimeFormat(locale,{dateStyle:'medium',timeStyle:'short',timeZone:'UTC'}).format(new Date(v)):t.notStarted;
const arm=(id:string)=>t.arms[id as keyof typeof t.arms]??id;
const blocker=(id:string)=>t.blockers[id as keyof typeof t.blockers]??id;
const groups=summarizeControls(snapshot,{market:'US',feeBps:20});
const highlights=controlsHighlights(snapshot);
---
<section id="strategy-controls" class:list={['strategy-controls',{'controls-overview':compact}]} data-ready={compact?'static':snapshot.status==='measured'?'pending':'withheld'} data-controls-facts={compact?undefined:JSON.stringify(snapshot)}>
 <p class="eyebrow">{t.eyebrow}</p><h2>{t.title}</h2>
 <p class="controls-conclusion" data-controls-conclusion>{snapshot.status==='measured'?t.measured:t.withheld}</p><p>{t.intro}</p>
 {highlights.length>0&&<div class="headline-grid">{highlights.map(h=><article class="headline-card" data-controls-highlight={h.market} data-highlight-facts={JSON.stringify(h)}>
  <p class="headline-market">{t.markets[h.market as 'US'|'crypto']} <span>{t.headlines.historical}</span></p>
  <h3>{t.headlines[h.market as 'US'|'crypto'].title}</h3><p>{t.headlines[h.market as 'US'|'crypto'].body}</p>
  <div class="headline-metric">{number.format(h.medianReturnChange*100)}<span>{t.percentagePoints}</span></div><p class="headline-caption">{t.headlines.medianEdge}</p>
  <dl><div><dt>{t.headlines.higherReturn}</dt><dd>{h.returnWins} / {h.windows}</dd></div><div><dt>{t.headlines.lowerDrawdown}</dt><dd>{h.drawdownWins} / {h.windows}</dd></div></dl>
  <p class="headline-context">{arm(h.armId)}<br/>{t.headlines.versus} {arm(h.control)} · {h.feeBps} bps</p>
 </article>)}<article class="headline-card evidence-card"><p class="headline-market">{t.headlines.evidence}</p><h3>{t.headlines.evidenceTitle}</h3><p>{t.headlines.evidenceBody}</p><div class="headline-metric">{readiness.observation.observations}<span>{t.observations}</span></div><p class="headline-caption">{t.headlines.observationLimit}</p><a href={`${prefix}docs/observation-registry/`}>{t.observationGuide} ↗</a></article></div>}
 <dl class="control-counts">{(['requested','completed','blocked'] as const).map(key=><div><dt>{t.counts[key]}</dt><dd data-controls-count={key}>{number.format(snapshot.coverage[`${key}_jobs`])}</dd></div>)}</dl>
 {snapshot.status==='readiness_only'&&<div class="publication-note"><p>{t.publication}</p><ul>{snapshot.blockers.map(code=><li>{blocker(code)}</li>)}</ul></div>}
 <p class="detail">{t.limits}</p><a href={`${prefix}docs/strategy-controls/`}>{t.guide} ↗</a>
 {compact&&<a class="overview-action" href={`${prefix}strategies/#strategy-controls`}>{t.headlines.explore} ↗</a>}
 {!compact&&snapshot.status==='measured'&&<>
  <div class="control-filters" data-controls-filters hidden>
   <label>{t.market}<select data-controls-filter="market"><option value="US">{t.markets.US}</option><option value="crypto">{t.markets.crypto}</option></select></label>
   <label>{t.fee}<select data-controls-filter="fee" /></label><label>{t.arm}<select data-controls-filter="arm" /></label><label>{t.window}<select data-controls-filter="window" /></label>
  </div>
  <p data-controls-status aria-live="polite">{t.measured}</p>
  <p class="selection-conclusion" data-controls-selection-conclusion aria-live="polite"></p>
  <div class="control-charts">{(['paired','turnover','risk','fees'] as const).map(id=><figure><figcaption>{t.charts[id]}</figcaption><div class="control-chart" data-controls-chart={id} role="img" aria-label={t.charts[id]}></div><p class="detail">{id==='risk'?t.riskNote:id==='fees'?t.costNote:t.chartNote}</p></figure>)}</div>
  <div class="control-scroll"><table><thead><tr>{[t.columns.strategy,t.columns.cost,t.columns.count,t.columns.return,t.columns.drawdown,t.columns.volatility,t.columns.turnover,t.columns.exposure].map(label=><th>{label}</th>)}</tr></thead><tbody data-controls-summary>{groups.map((g:any)=><tr><th>{arm(g.arm_id)}</th><td>{g.fee_bps}</td><td>{g.count}</td>{['net_return','max_drawdown','volatility','turnover','exposure'].map(k=><td>{percent(g[k])}</td>)}</tr>)}</tbody></table></div>
  <details class="control-window-values"><summary>{t.facts}</summary><div class="control-scroll"><table><thead><tr>{[t.market,t.columns.strategy,t.columns.window,t.columns.cost,t.columns.return,t.columns.drawdown,t.columns.volatility,t.columns.turnover,t.columns.exposure].map(label=><th>{label}</th>)}</tr></thead><tbody>{snapshot.results.map((r:any)=><tr data-controls-result={JSON.stringify(r)}><td>{t.markets[r.market as 'US'|'crypto']}</td><th>{arm(r.arm_id)}</th><td>{r.start}<br/>{r.end}</td><td>{r.fee_bps}</td>{['net_return','max_drawdown','volatility','mean_daily_turnover','mean_exposure'].map(k=><td>{percent(r.metrics[k])}</td>)}</tr>)}</tbody></table></div></details>
  <script type="application/json" data-controls-config set:html={JSON.stringify({locale,t}).replace(/</g,'\\u003c')} />
 </>}
 <details><summary>{t.methodsTitle}</summary><div class="control-scroll"><table><thead><tr><th>{t.market}</th><th>{t.method}</th><th>{t.parameters}</th></tr></thead><tbody>{snapshot.methods.map(m=><tr data-controls-method={m.arm_id}><td>{t.markets[m.market as 'US'|'crypto']}</td><th>{arm(m.arm_id)}<br/><span class="detail">{t.roles[m.role as keyof typeof t.roles]}</span></th><td><code>{m.arm_id}</code><br/><code>{JSON.stringify(m.parameters)}</code></td></tr>)}</tbody></table></div></details>
 {!compact&&<aside id="strategy-readiness" data-readiness-facts={JSON.stringify(readiness)}>
  <h3>{t.readinessTitle}</h3><div class="readiness-cards">
   <article><p class="pill">{t.blocked}</p><h4>{t.executionTitle}</h4><p>{t.executionBody}</p><p>{t.datasetsChecked}: {number.format(readiness.execution.datasets_checked)}</p><ul>{readiness.execution.blockers.map(code=><li>{blocker(code)}</li>)}</ul><a href={`${prefix}docs/execution-evidence/`}>{t.executionGuide} ↗</a></article>
   <article><p class="pill">{readiness.observation.status==='awaiting_new_data'?t.awaiting:t.observing}</p><h4>{t.observationTitle}</h4><p>{readiness.observation.status==='awaiting_new_data'?t.observationBody:t.observationActive}</p><dl><dt>{t.observations}</dt><dd>{number.format(readiness.observation.observations)}</dd><dt>{t.frozen}</dt><dd>{date(readiness.observation.freeze_at)}</dd><dt>{t.firstObservation}</dt><dd>{date(readiness.observation.first_eligible_observation_at)}</dd></dl><a href={`${prefix}docs/observation-registry/`}>{t.observationGuide} ↗</a></article>
  </div>
 </aside>}
 <details><summary>{t.provenance}</summary><p>{date(snapshot.as_of)}</p><p><code>{snapshot.code_commit}</code><br/><code>{snapshot.plan_sha256}</code><br/><code>{readiness.observation.protocol_id}</code></p></details>
</section>
<script>
 const root=document.getElementById('strategy-controls');
 if(root?.dataset.ready==='pending'){
  const observer=new IntersectionObserver(async entries=>{
   if(!entries.some(e=>e.isIntersecting))return;observer.disconnect();
   try{const {mountStrategyControls}=await import('../scripts/strategy-controls-charts.mjs');mountStrategyControls(root);}
   catch(error){const config=JSON.parse(root.querySelector('[data-controls-config]')!.textContent!);root.querySelector('[data-controls-status]')!.textContent=config.t.loadError;root.dataset.ready='error';console.error('Strategy controls charts could not load',error);}
  },{rootMargin:'200px'});observer.observe(root);
 }
</script>
<style>
.headline-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.7rem 0}.headline-card{background:var(--surface);border:1px solid var(--line);border-radius:1rem;padding:1.4rem;min-width:0;display:flex;flex-direction:column}.headline-market{display:flex;align-items:center;justify-content:space-between;gap:.5rem;color:var(--green);font-size:.78rem;font-weight:700;margin-bottom:1rem}.headline-market span{color:var(--muted);font-weight:400}.headline-card h3{font-size:1.25rem;line-height:1.4;margin-bottom:.75rem}.headline-card>p:not(.headline-market){font-size:.88rem;color:var(--muted)}.headline-metric{font-size:2.3rem;line-height:1.2;letter-spacing:-.04em;font-weight:650;font-variant-numeric:tabular-nums;margin-top:auto;padding-top:1.2rem}.headline-metric span{font-size:.8rem;font-weight:400;letter-spacing:0;margin-left:.3rem;color:var(--muted)}.headline-caption{margin:.3rem 0 1rem}.headline-card dl{display:flex;gap:1.6rem;border-top:1px solid var(--line);padding-top:1rem;margin:.3rem 0 .8rem}.headline-card dt{font-size:.75rem;color:var(--muted)}.headline-card dd{margin:.25rem 0;font-variant-numeric:tabular-nums;font-weight:650}.headline-context{font-size:.75rem!important;margin-bottom:0}.evidence-card{background:var(--flow)}.evidence-card a{font-size:.85rem}.controls-overview{border-top:0!important;padding-top:0!important}.overview-action{display:inline-flex;margin:1rem 0 0 1rem;font-weight:650}.controls-overview .control-counts{padding:1rem 0}.controls-overview .control-counts dd{font-size:1.4rem}.controls-overview details{font-size:.8rem}.control-charts{margin-top:1.2rem}.control-charts figure{border-radius:0}.control-filters{border-radius:0;background:var(--surface)}.control-counts{padding:1.2rem 0;border-block:1px solid var(--line)}@media(max-width:900px){.headline-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.evidence-card{grid-column:1/-1}}@media(max-width:560px){.headline-grid{grid-template-columns:minmax(0,1fr)}.evidence-card{grid-column:auto}.overview-action{margin-left:0}.headline-card{padding:1.2rem}.headline-metric{font-size:2rem}}
.strategy-controls{border-top:1px solid var(--line);padding:2rem 0;min-width:0}.controls-conclusion{font-size:1.2rem;font-weight:650;max-width:70ch}.control-counts{display:flex;flex-wrap:wrap;gap:2.5rem}.control-counts dt{font-size:.85rem;color:var(--muted)}.control-counts dd{margin:0;font-size:2rem;font-variant-numeric:tabular-nums}.publication-note{border-left:3px solid var(--green);padding:.25rem 1rem;background:var(--surface)}.control-filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;padding:1rem;border:1px solid var(--line);border-radius:.5rem;margin-top:1.5rem}.control-filters[hidden]{display:none}.control-filters label{display:grid;gap:.4rem;font-size:.85rem;min-width:0}.control-filters select{width:100%;min-width:0;font:inherit;color:var(--ink);background:var(--paper);padding:.5rem;border:1px solid var(--line);border-radius:.3rem}.control-charts,.readiness-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.control-charts figure,.readiness-cards article{margin:0;padding:1rem 0;border:0;border-top:1px solid var(--line);border-radius:0;min-width:0;background:transparent}.control-charts figcaption{font-weight:650}.control-chart{height:330px;width:100%;overflow:hidden;margin-top:.75rem}.control-scroll{overflow-x:auto;margin:1rem 0;max-width:100%}table{width:100%;min-width:52rem;border-collapse:collapse;text-align:left;font-size:.85rem}td,th{padding:.65rem .5rem;border-bottom:1px solid var(--line);vertical-align:top}thead{color:var(--table-heading);background:var(--table-bg)}details{border-bottom:1px solid var(--line);padding:.6rem 0}summary{cursor:pointer;padding:.4rem 0}code{overflow-wrap:anywhere;font-size:.8rem}.readiness-cards dd{margin:0 0 .75rem}.readiness-cards dt{color:var(--muted);font-size:.85rem}.readiness-cards ul{padding-left:1.2rem}.readiness-cards li{margin:.4rem 0}tr[hidden]{display:none}@media(max-width:800px){.control-charts,.readiness-cards{grid-template-columns:minmax(0,1fr)}.control-filters{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:450px){.control-filters{grid-template-columns:minmax(0,1fr)}.control-counts{gap:1.2rem}}
</style>
