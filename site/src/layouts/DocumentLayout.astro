---
import SiteNavigation from "../components/SiteNavigation.astro";
import SiteLayout from "./SiteLayout.astro";
import { documents, type DocumentEntry } from "../lib/documents";
import en from "../i18n/en.json";
import zh from "../i18n/zh-CN.json";
interface Props { doc: DocumentEntry }
const {doc}=Astro.props;
const locale=doc.locale==="zh-CN"?"zh-CN":"en";
const t=(locale==="zh-CN"?zh:en).documents;
const title=t.titles[doc.slug as keyof typeof t.titles];
const Content=doc.Content;
const prefix=`/2026-quant-competition/${locale==="zh-CN"?"zh-CN/":""}`;
---
<SiteLayout locale={locale} localePath={`docs/${doc.slug}/`} title={`${title} | QUANT / LAB`} description={t.intro}>
  <SiteNavigation locale={locale} active="docs" />
  <header class="doc-header"><a href={prefix}>{(locale==='en'?en:zh).pages.labels.home}</a><a href={`${prefix}strategies/#performance`}>{t.dashboard}</a><a href={`${prefix}docs/`}>{t.title}</a></header>
  <main class="doc-shell">
    <aside><nav aria-label={t.title}>{documents.filter(d=>d.locale===locale).map(d=><a href={d.route} aria-current={d.slug===doc.slug?"page":undefined}>{t.titles[d.slug as keyof typeof t.titles]}</a>)}</nav></aside>
    <div class="doc-body"><p class="doc-note">{t.canonical} <a href={`https://github.com/runchengxie/2026-quant-competition/blob/main/${doc.source}`}>{t.source} ↗</a></p><article><Content /></article></div>
  </main>
</SiteLayout>
<style>
.doc-header { display:flex; gap:1.5rem; flex-wrap:wrap; margin:1.5rem auto 2rem; max-width:1220px; padding:0 42px;font-size:.8rem; }
.doc-header a:first-child { margin-right:auto; }
.doc-shell { display:grid; grid-template-columns:200px minmax(0,1fr); gap:3rem; max-width:1220px; margin:auto; padding:0 42px 4rem; }
aside nav { display:grid; gap:.25rem; position:sticky; top:1rem; border:0;border-right:1px solid var(--line);padding:0 1rem 0 0;background:transparent; }
aside a {font-size:.82rem;text-decoration:none;padding:.55rem 0;color:var(--muted)}
aside a[aria-current] {font-weight:600;text-decoration:underline;text-underline-offset:5px;color:var(--ink)}
.doc-body { min-width:0;max-width:760px;line-height:1.9 }
.doc-note { color:var(--muted); font-size:.78rem; }
article { overflow-wrap:anywhere; }
article :global(h1) { font-size:clamp(1.8rem,4vw,2.5rem); line-height:1.3; }
article :global(h2) { margin-top:2.5rem; font-size:1.5rem; }
article :global(pre) { background:var(--surface);border:1px solid var(--line);font-size:.85rem; overflow-x:auto; max-width:100%; padding:1rem; border-radius:.5rem; }
article :global(table) { display:block; overflow-x:auto; max-width:100%; border-collapse:collapse; }
article :global(td),article :global(th) { border-bottom:1px solid var(--line); padding:.6rem; }
article :global(img) { max-width:100%; }
article :global(.cnn-gallery) { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin:2rem 0; }
article :global(.cnn-gallery figure) { margin:0;min-width:0;padding:1rem;border:1px solid var(--line);background:var(--surface); }
article :global(.cnn-gallery img) { display:block;width:240px;height:auto;margin:0 auto 1rem;image-rendering:pixelated; }
article :global(.cnn-gallery figcaption) { font-size:.85rem;line-height:1.8;color:var(--muted); }
article :global(.cnn-performance) { margin:2rem 0; }
article :global(.cnn-performance img) { display:block;width:100%;height:auto;border:1px solid var(--line); }
article :global(.cnn-performance figcaption) { margin-top:.7rem;font-size:.85rem;line-height:1.8;color:var(--muted); }
@media(max-width:600px) { article :global(.cnn-gallery) { grid-template-columns:1fr; } }
@media(max-width:700px) { .doc-header{padding-inline:23px}.doc-shell { grid-template-columns:minmax(0,1fr); gap:1.5rem;padding-inline:23px; } aside nav { display:flex; flex-wrap:wrap; position:static; gap:.2rem 1rem;border-right:0;border-bottom:1px solid var(--line);padding:0 0 1rem } }
</style>
